# ---------------------------------------------------------------
# Tiny Humans environment variables. Copy to .env.local for local
# development; add the same names in Vercel > Settings > Environment
# Variables. Never commit real values. Only NEXT_PUBLIC_* values are
# visible in the browser.
# ---------------------------------------------------------------

# Booking provider: "mock" (no real calendar, default) or "outlook"
# (Outlook Calendar via Microsoft Graph, saved in Neon, emails via Resend).
BOOKING_PROVIDER=mock

# Neon PostgreSQL connection string (use the pooled connection string)
DATABASE_URL=

# Microsoft Entra app registration (server only)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Outlook calendar that holds sessions (Microsoft Graph is used for the calendar only)
OUTLOOK_MAILBOX=hello@tinyhumans.photography
OUTLOOK_CALENDAR_USER=hello@tinyhumans.photography

# Booking emails (customer confirmation + internal new-booking notification) via Resend
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=hello@tinyhumans.photography
BOOKING_FROM_EMAIL=Tiny Humans <hello@tinyhumans.photography>
# Sender for internal emails (new lead / cancelled / rescheduled). Falls back to BOOKING_FROM_EMAIL.
BOOKING_INTERNAL_FROM_EMAIL=no-reply <hello@tinyhumans.photography>

# Public site address (used in emails and page metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner area (/admin)
ADMIN_PASSWORD=
# Any long random string (at least 16 characters), e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# Vercel Blob (live theme + uploaded photos). Added automatically when you
# connect a Blob store in Vercel > Storage.
BLOB_READ_WRITE_TOKEN=

# Local development only (never set on Vercel): Neon-compatible endpoint served by scripts/local-db.
# With it, use DATABASE_URL=postgres://tiny:tiny@localhost:5433/tinyhumans
NEON_LOCAL_FETCH_ENDPOINT=

# Rate limiting (Upstash Redis from the Vercel Marketplace adds these automatically).
# Without them, a per-instance in-memory limit is used (fine locally, weak on Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Local development only (never set on Vercel): fake Microsoft Graph from scripts/local-db/fake-graph.mjs
MICROSOFT_GRAPH_BASE_URL=
MICROSOFT_LOGIN_BASE_URL=

# Meta Pixel + Conversions API (missing values = tracking quietly does nothing)
# Dataset (Pixel) ID from Events Manager; public (used in the browser).
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (server only; Events Manager > dataset > Settings > Conversions API).
META_CAPI_ACCESS_TOKEN=
# Testing only: events go to Events Manager > Test events and are NOT used by ads. Remove after testing.
META_TEST_EVENT_CODE=

# Daily reminder emails (Vercel Cron): random string, at least 16 characters. Vercel sends it to /api/cron/reminders.
CRON_SECRET=

# Card payments after the session (Stripe Checkout, exact booked amount). Restricted key (rk_live_...) with
# "Checkout Sessions: Write". Webhook signing secret (whsec_...) from the webhook pointed at /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local development only (never set on Vercel): fake Stripe from scripts/local-db/fake-stripe.mjs
STRIPE_API_BASE=
